# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
AUTH_MODE=development
# AUTH_MODE=session registers real cookie auth. Farm-admin SQL additionally
# requires an attested RUNTIME_DATABASE_URL; staff permissions remain blocked.
# The migrated browser requires session mode; development mode is parity-only.
# Production requires the separately reviewed owner-only profile; see
# docs/OWNER_RELEASE.md and ops/runtime.env.example.
APP_ORIGIN=http://localhost:4200
PORT=3000

# Private auth/metadata connection (legacy demo connection in development mode).
# Business SQL in session mode NEVER runs on this connection.
DATABASE_URL=postgres://farm_auth:CHANGE_ME@localhost:5432/farminfantary

# Optional separate DDL-capable role for `npm run db:migrate`.
# Falls back to DATABASE_URL for local development. Never give the API DDL privileges.
MIGRATION_DATABASE_URL=

# New restricted login, provisioned out of band after migration 004. Never reuse
# the migration/auth role. See docs/SQL_GUARD.md for activation and limits.
# URL password: 32–128 random base64url characters; no URL startup options.
RUNTIME_DATABASE_URL=
DATABASE_SCHEMA=public

# Session cookie signing secret. Generate per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# First super admin, consumed once by the bootstrap command (see docs/DECISIONS.md D11)
BOOTSTRAP_SUPERADMIN_USERNAME=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Guard limits
STATEMENT_TIMEOUT_MS=10000
MAX_ROWS_PER_QUERY=50000
RATE_LIMIT_PER_MINUTE=600
