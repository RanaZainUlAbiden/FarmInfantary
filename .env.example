# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL — the application role must NOT own the tables
# and must NOT have BYPASSRLS, or row-level security does nothing.
DATABASE_URL=postgres://farminfantary_app:CHANGE_ME@localhost:5432/farminfantary

# Session cookie signing secret. Generate per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# First super admin, consumed once by the bootstrap command (see docs/DECISIONS.md D11)
BOOTSTRAP_SUPERADMIN_USERNAME=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Guard limits
STATEMENT_TIMEOUT_MS=10000
MAX_ROWS_PER_QUERY=50000
RATE_LIMIT_PER_MINUTE=600
