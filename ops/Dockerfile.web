FROM node:24-bookworm-slim AS frontend
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit
COPY angular.json tsconfig*.json ./
COPY src ./src
COPY public ./public
RUN npm run build -- --progress=false

FROM caddy:2-alpine
COPY --from=frontend /app/dist/farminfantary/browser /srv
COPY ops/Caddyfile /etc/caddy/Caddyfile
