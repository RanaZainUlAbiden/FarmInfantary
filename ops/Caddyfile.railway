{
 auto_https off
 admin off
}
:{$PORT:8080} {
 encode zstd gzip
 request_body {
  max_size 2MB
 }
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options "nosniff"
  X-Frame-Options "DENY"
  Referrer-Policy "same-origin"
  Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
 }
 handle /api/* {
  reverse_proxy 127.0.0.1:3000 {
   transport http {
    response_header_timeout 90s
   }
  }
 }
 # Built files carry a content hash in their name (main-ABC123XY.js), so a file
 # with that name never changes: browsers may keep it for a year instead of
 # re-checking each one over a slow connection. The `file` matcher means a missing
 # (old) chunk that falls back to index.html is never cached as immutable.
 @hashed {
  path_regexp hashed ^/[A-Za-z0-9_.-]+-[A-Z0-9]{8}\.(js|css)$
  file {
   root /srv
  }
 }
 handle @hashed {
  root * /srv
  header Cache-Control "public, max-age=31536000, immutable"
  file_server
 }
 handle {
  root * /srv
  try_files {path} /index.html
  header Cache-Control "no-cache"
  file_server
 }
}
