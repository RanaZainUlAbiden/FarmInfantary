# Operator-only, kept separate from API/container environment.
# The backup login must be able to dump all tenant rows; never give it to the API.
BACKUP_DATABASE_URL=postgres://farm_migration:REPLACE@127.0.0.1:55432/farminfantary
BACKUP_DIR=/var/backups/farminfantary
BACKUP_RETAIN=7
BACKUP_ENCRYPTION_KEY=
# Optional full paths to matching PostgreSQL 18 client tools:
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
# Restore is operator-only and requires a dedicated NEW EMPTY database:
RESTORE_DATABASE_URL=
DATABASE_SCHEMA=public
