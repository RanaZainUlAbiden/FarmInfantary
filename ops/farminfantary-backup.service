[Unit]
Description=FarmInfantary encrypted PostgreSQL backup
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=farminfantary-backup
WorkingDirectory=/srv/farminfantary
EnvironmentFile=/etc/farminfantary/backup.env
ExecStart=/usr/bin/node /srv/farminfantary/scripts/ops/backup.mjs create
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/farminfantary
TimeoutStartSec=20min
