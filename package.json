{
  "name": "farminfantary",
  "version": "0.1.0",
  "private": true,
  "description": "FarmInfantary — web poultry farm management",
  "scripts": {
    "start": "ng serve",
    "build": "ng build && node scripts/check-production-shell.mjs",
    "watch": "ng build --watch --configuration development",
    "verify": "node scripts/verify/run-all.mjs",
    "db:migrate": "node db/migrate.mjs",
    "db:provision-runtime": "node db/provision-runtime.mjs",
    "db:provision-auth": "node db/provision-auth.mjs",
    "release:info": "node server/src/release.js",
    "backup:create": "node scripts/ops/backup.mjs create",
    "auth:bootstrap": "npm --prefix server run auth:bootstrap",
    "api:dev": "npm --prefix server run dev",
    "api:test": "npm --prefix server test"
  },
  "dependencies": {
    "@angular/animations": "~20.3.34",
    "@angular/common": "~20.3.34",
    "@angular/compiler": "~20.3.34",
    "@angular/core": "~20.3.34",
    "@angular/forms": "~20.3.34",
    "@angular/platform-browser": "~20.3.34",
    "@angular/platform-browser-dynamic": "~20.3.34",
    "@angular/router": "~20.3.34",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "~20.3.41",
    "@angular/cli": "~20.3.41",
    "@angular/compiler-cli": "~20.3.34",
    "typescript": "~5.9.3"
  }
}
